{
  "name": "@recallfeed/client",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "A typed client for the RecallFeed HTTP API, for frontends, scripts and CLIs. Depends only on @recallfeed/core and fetch.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@recallfeed/core": "workspace:*"
  }
}
