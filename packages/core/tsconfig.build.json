{
  // Emits JavaScript and declarations to dist/. Inside the monorepo, consumers
  // import src/index.ts directly, so dist/ exists to prove the package compiles.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // A failed compile must not write files: tsc emits on error by default, and stray
    // .js files next to .ts sources shadow them in Vite and silently break tests and coverage.
    "noEmitOnError": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  }
}
