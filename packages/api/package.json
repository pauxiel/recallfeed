{
  "name": "@recallfeed/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "RecallFeed HTTP API: a Hono application and Cloudflare Worker entry point. Behavior differs between deployments by environment variables only.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint .",
    "dev:local": "wrangler dev --config wrangler.local.toml"
  },
  "dependencies": {
    "@recallfeed/connectors": "workspace:*",
    "@recallfeed/core": "workspace:*",
    "@recallfeed/database": "workspace:*",
    "@recallfeed/feed-engine": "workspace:*",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  }
}
