{
  // Test files run in the Workers runtime (workerd) and may use Workers globals.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/migrate-node.ts",
    "src/migrate-cli.ts",
    "src/test-fixture-node.ts",
    "src/__tests__/setup.ts",
    "src/__tests__/*.node.test.ts"
  ]
}
