{
  // Workspace-wide typecheck (`pnpm typecheck`). It covers package source, tests,
  // and root tool configuration. Each package keeps its own stricter tsconfig.json
  // for its source files (for example, core declares no ambient runtime types).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "vitest.config.ts"
  ],
  // Node-only scripts are checked by their package's tsconfig.node.json, because they use
  // Node globals that the Workers type set deliberately omits.
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/coverage",
    "packages/*/src/**/*-node.ts",
    "packages/*/src/**/*-cli.ts",
    "packages/*/src/__tests__/setup.ts",
    "packages/*/src/**/*.node.test.ts",
    "packages/*/vitest.config.ts",
    "packages/*/vitest.node.config.ts"
  ]
}
