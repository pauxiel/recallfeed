# Copy to .env.test (git-ignored) only if you need a non-default test database.
# `pnpm --filter @recallfeed/database test:integration` already defaults to this value.
#
# This points at the disposable local stack in packages/database/docker/compose.test.yaml.
# The test setup DROPS and recreates the public schema, so it refuses any host other than
# localhost, 127.0.0.1, ::1, or db.localtest.me, and any database name without the word
# "test". These credentials protect a throwaway database on loopback; they are not secrets.
TEST_DATABASE_URL=postgres://postgres:postgres@db.localtest.me:5432/recallfeed_test
